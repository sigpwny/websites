---
import type { CollectionEntry } from 'astro:content';
import Avatar from './Avatar.astro';
import ProfileTooltipTrigger from './ProfileTooltipTrigger.astro';

type Profile = CollectionEntry<'profiles'>['data'];

interface Props {
  profile: Profile;
  placement?: 'bottom-start' | 'bottom-end';
}

const { profile, placement }: Props = Astro.props;
---

<span class="flex flex-row gap-2 items-center">
  <span class="flex shrink-0 grow-0">
    <ProfileTooltipTrigger profile={profile} placement={placement} class="size-8">
      <Avatar profile={profile} />
    </ProfileTooltipTrigger>
  </span>
  <span class="flex flex-row items-center">
    <slot />
  </span>
</span>
