<div
  id="profile-tooltip"
  class="z-50 m-0 border-0 bg-transparent p-0 text-content"
  popover="auto"
  role="dialog"
  aria-label="Profile details"
  tabindex="-1"
>
  <div data-profile-tooltip-body></div>
</div>

<script>
  let activeTrigger: HTMLElement | null = null;

  const supportsPopover =
    typeof HTMLElement !== 'undefined' && 'showPopover' in HTMLElement.prototype;

  function getTooltip() {
    return document.querySelector<HTMLElement>('#profile-tooltip');
  }

  function isPopoverOpen(tooltip: HTMLElement) {
    if (supportsPopover) return tooltip.matches(':popover-open');
    return tooltip.classList.contains('is-open');
  }

  function showTooltip(tooltip: HTMLElement) {
    if (supportsPopover) {
      tooltip.showPopover();
    } else {
      tooltip.classList.add('is-open');
    }
  }

  function hideTooltip(tooltip: HTMLElement) {
    if (supportsPopover) {
      tooltip.hidePopover();
    } else {
      tooltip.classList.remove('is-open');
    }
  }

  function positionTooltip(trigger: HTMLElement, tooltip: HTMLElement) {
    if (!supportsPopover) return;

    const gap = 8;
    const triggerRect = trigger.getBoundingClientRect();
    const tooltipRect = tooltip.getBoundingClientRect();
    const placement = trigger.dataset.profileTooltipPlacement ?? 'bottom-start';

    let left = placement.endsWith('end')
      ? triggerRect.right - tooltipRect.width
      : triggerRect.left;
    let top = triggerRect.bottom + gap;

    if (top + tooltipRect.height > window.innerHeight - gap) {
      top = triggerRect.top - tooltipRect.height - gap;
    }

    left = Math.max(gap, Math.min(left, window.innerWidth - tooltipRect.width - gap));
    top = Math.max(gap, Math.min(top, window.innerHeight - tooltipRect.height - gap));

    tooltip.style.left = `${left}px`;
    tooltip.style.top = `${top}px`;
  }

  function bindTooltip() {
    const tooltip = getTooltip();
    if (!tooltip || tooltip.dataset.bound === 'true') return;

    tooltip.dataset.bound = 'true';

    if (supportsPopover) {
      tooltip.addEventListener('toggle', () => {
        if (isPopoverOpen(tooltip)) return;

        activeTrigger?.setAttribute('aria-expanded', 'false');
        activeTrigger = null;
        tooltip.querySelector('[data-profile-tooltip-body]')?.replaceChildren();
      });
    }
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;

    const trigger = event.target.closest<HTMLElement>('[data-profile-tooltip-trigger]');
    if (!trigger) {
      const tooltip = getTooltip();
      if (activeTrigger && tooltip && isPopoverOpen(tooltip) && !event.target.closest('#profile-tooltip')) {
        hideTooltip(tooltip);
      }
      return;
    }

    const tooltip = getTooltip();
    const template = trigger.nextElementSibling;
    const body = tooltip?.querySelector('[data-profile-tooltip-body]');
    if (!tooltip || !(template instanceof HTMLTemplateElement) || !body) return;

    if (activeTrigger === trigger && isPopoverOpen(tooltip)) {
      if (supportsPopover) {
        hideTooltip(tooltip);
        return;
      }
    }

    activeTrigger?.setAttribute('aria-expanded', 'false');
    activeTrigger = trigger;
    trigger.setAttribute('aria-expanded', 'true');
    body.replaceChildren(template.content.cloneNode(true));

    if (!isPopoverOpen(tooltip)) showTooltip(tooltip);
    positionTooltip(trigger, tooltip);
  });

  window.addEventListener('resize', () => {
    const tooltip = getTooltip();
    if (activeTrigger && tooltip && isPopoverOpen(tooltip)) {
      positionTooltip(activeTrigger, tooltip);
    }
  });

  document.addEventListener('scroll', () => {
    const tooltip = getTooltip();
    if (activeTrigger && tooltip && isPopoverOpen(tooltip)) {
      positionTooltip(activeTrigger, tooltip);
    }
  }, true);

  document.addEventListener('astro:before-swap', () => {
    const tooltip = getTooltip();
    if (tooltip && isPopoverOpen(tooltip)) hideTooltip(tooltip);
  });
  if (!supportsPopover) {
    let hoverTimeout: ReturnType<typeof setTimeout> | null = null;

    document.addEventListener('mouseover', (event) => {
      const trigger = event.target instanceof Element
        ? event.target.closest<HTMLElement>('[data-profile-tooltip-trigger]')
        : null;
      if (!trigger) return;

      const tooltip = getTooltip();
      const template = trigger.nextElementSibling;
      const body = tooltip?.querySelector('[data-profile-tooltip-body]');
      if (!tooltip || !(template instanceof HTMLTemplateElement) || !body) return;

      if (hoverTimeout) clearTimeout(hoverTimeout);
      body.replaceChildren(template.content.cloneNode(true));
      tooltip.style.left = '0';
      tooltip.style.top = '0';
      showTooltip(tooltip);
    });

    document.addEventListener('mouseout', (event) => {
      const related = event.relatedTarget instanceof Element
        ? event.relatedTarget.closest<HTMLElement>('[data-profile-tooltip-trigger]')
        : null;
      if (related) return;

      const tooltip = getTooltip();
      if (!tooltip) return;

      if (event.relatedTarget instanceof Element && event.relatedTarget.closest('#profile-tooltip')) return;

      hoverTimeout = setTimeout(() => {
        hideTooltip(tooltip);
        tooltip.querySelector('[data-profile-tooltip-body]')?.replaceChildren();
      }, 100);
    });
  }

  document.addEventListener('astro:page-load', bindTooltip);
  bindTooltip();
</script>

<style>
  #profile-tooltip {
    inset: unset;
    position: fixed;
    width: min(28rem, calc(100vw - 1rem));
  }

  #profile-tooltip::backdrop {
    background: transparent;
  }

  :where(#profile-tooltip:not(:popover-open)) {
    display: none;
  }

  #profile-tooltip.is-open {
    display: block;
  }
</style>
