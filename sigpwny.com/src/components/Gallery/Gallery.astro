---
import { GalleryLoader } from './GalleryLoader';

interface Props {
  manifestUrl: string;
}

const { manifestUrl } = Astro.props;
---
<GalleryLoader manifestUrl={manifestUrl} client:load />
<noscript>Enable JavaScript to load the photo albums.</noscript>

<style is:global>
  :root[data-gallery-open] {
    overflow-y: hidden;
    scrollbar-gutter: stable;
  }

  /* Keep the live page and sticky navbar beneath the scrim, not a page-sized snapshot. */
  :root[data-gallery-transition] {
    view-transition-name: none;
  }

  /* Let Close and newly revealed album buttons interrupt an animation. */
  :root[data-gallery-transition]::view-transition { pointer-events: none; }

  [data-animating] [data-gallery-photo] { visibility: hidden; }

  /* Keep the snapshot transparent so its clipped, moving pair can animate the
     placeholder color without tinting the photo or painting a full-size frame. */
  :root[data-gallery-transition] button[aria-pressed] [data-gallery-photo] {
    background-color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-group(gallery-photo) {
      animation-duration: 250ms;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    ::view-transition-image-pair(gallery-photo) {
      overflow: hidden;
      animation-name: gallery-placeholder-color;
      animation-duration: 250ms;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      animation-fill-mode: both;
    }

    :root[data-gallery-transition='close']::view-transition-image-pair(gallery-photo) {
      animation-direction: reverse;
    }

    ::view-transition-old(gallery-photo),
    ::view-transition-new(gallery-photo) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--gallery-thumbnail-position, 50% 50%);
      animation: none;
      mix-blend-mode: normal;
    }

    :root[data-gallery-morph]::view-transition-group(gallery-photo) {
      width: var(--gallery-morph-width);
      height: var(--gallery-morph-height);
      transform-origin: 0 0;
      animation-name: gallery-photo-morph;
      animation-fill-mode: both;
      will-change: transform, clip-path;
    }

    :root[data-gallery-transition='open']::view-transition-old(gallery-photo),
    :root[data-gallery-transition='close']::view-transition-new(gallery-photo) {
      opacity: 0;
    }

    :root[data-gallery-transition='open']::view-transition-new(gallery-photo),
    :root[data-gallery-transition='close']::view-transition-old(gallery-photo) {
      opacity: 1;
    }

  }

  @keyframes gallery-placeholder-color {
    from { background-color: rgb(var(--rgb-surface-200)); }
    to { background-color: rgb(var(--rgb-surface-150)); }
  }

  @keyframes gallery-photo-morph {
    from {
      transform: var(--gallery-morph-from-transform);
      clip-path: var(--gallery-morph-from-clip);
    }
    to {
      transform: var(--gallery-morph-to-transform);
      clip-path: var(--gallery-morph-to-clip);
    }
  }
</style>
