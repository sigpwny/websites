---
---
<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link href="/manage/config.yml" type="text/yaml" rel="cms-config-url" />
    <title>sigpwny.com CMS</title>
    <style is:inline>
      ::view-transition-group(*),
      ::view-transition-image-pair(*),
      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation: none !important;
      }
    </style>
  </head>
    <body>
      <script is:inline>window.CMS_MANUAL_INIT = true;</script>
      <script is:inline src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"></script>
      <script
        is:inline
        src="https://api.sigpwny.com/widgets/recording.8e25cd0c264af538a4f2.js"
        integrity="sha384-jffbPhPp2Z8B4y5sS8tNHQnha10kmFnPvyvCkFsODQOzxHH/E5fCOzxFAYzERy8X"
        crossorigin="anonymous"
      ></script>
      <script is:inline>
        // Keep URL editing available if the pinned upload extension cannot load.
        if (!window.SIGPWNY_RECORDING_WIDGET_READY) {
          const field = CMS.getFieldType('string');
          CMS.registerFieldType('sigpwny-recording', field.control, field.preview);
        }
        CMS.init();
      </script>
    </body>
</html>
