---
import '@/styles/main.css';
import '$/styles/md.css';
import '$/styles/prism-one-dark.css';

import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import type { HeadProps } from '$/components/BaseHead.astro';
import BaseHead from '$/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ProfileTooltip from '@/components/Profile/ProfileTooltip.astro';

const props: Omit<HeadProps, "site_name"> = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <BaseHead {...props} site_name="sigpwny.com" />
    <Font
      cssVariable="--font-helvetica-neue"
      preload={[
        { weight: 400, style: 'normal' },
        { weight: 700, style: 'normal' },
      ]}
    />
    <ClientRouter />
  </head>
  <body>
    <div class="flex flex-col min-h-screen">
      <Header />
      <div class="container grow">
        <slot />
      </div>
    </div>
    <Footer />
    <ProfileTooltip />
  </body>
</html>
