---
import Layout from '@/layouts/Base.astro';
import type { HeadProps } from '$/components/BaseHead.astro';
import MeetingSidebar, {
  type MeetingSidebarEntry,
  type MeetingSidebarSemester,
} from '@/components/Meeting/Sidebar';
import {
  getSemesterToMeetingsMap,
  formatSemester,
  type Meeting,
} from '@/utils/meetings';
import 'katex/dist/katex.min.css';
import dayjs from 'dayjs';
import duration from 'dayjs/plugin/duration';

dayjs.extend(duration);

interface Props extends HeadProps {
  meeting: Meeting;
}

const { meeting, ...props } = Astro.props as Props;

const semesterToMeetingsMap = await getSemesterToMeetingsMap();
const sidebarSemesters = Array.from(semesterToMeetingsMap.entries()).map(([semester, meetings]) => {
  const chronologicalMeetings = [...meetings].sort(
    (a, b) => a.data.time_start.valueOf() - b.data.time_start.valueOf()
  );
  return {
    id: semester,
    name: formatSemester(semester),
    firstMeetingUrl: chronologicalMeetings[0].slug,
    firstMeetingByType: Object.fromEntries(
      chronologicalMeetings
        .filter((entry, index, entries) =>
          entries.findIndex((candidate) => candidate.data.type === entry.data.type) === index
        )
        .map((entry) => [entry.data.type, entry.slug])
    ),
  } satisfies MeetingSidebarSemester;
});
const semesterMeetings = [...(semesterToMeetingsMap.get(meeting.data.semester) ?? [])].sort(
  (a, b) => a.data.time_start.valueOf() - b.data.time_start.valueOf()
);
const sidebarMeetings = semesterMeetings.map((entry) => ({
  title: entry.data.title,
  slug: entry.slug,
  type: entry.data.type,
  timeStart: entry.data.time_start.valueOf(),
  timeClose: entry.data.time_start.valueOf() + dayjs.duration(entry.data.duration).asMilliseconds(),
  timezone: entry.data.timezone,
} satisfies MeetingSidebarEntry));
---

<Layout {...props}>
  <div class="flex flex-row gap-x-4">
    <aside
      class="xl:w-96 lg:w-80 lg:flex flex-col shrink-0 hidden"
      role="navigation"
      aria-label="Meetings"
    >
      <div class="w-full border-surface-100 border-2 rounded-xl sticky top-4">
        <MeetingSidebar
          activeSlug={meeting.slug}
          currentSemester={meeting.data.semester}
          meetings={sidebarMeetings}
          semesters={sidebarSemesters}
          client:load
          transition:persist="meeting-sidebar"
        />
      </div>
    </aside>
    <div class="w-full min-w-0 pb-8">
      <slot />
    </div>
  </div>
</Layout>
